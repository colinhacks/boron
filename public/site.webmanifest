{
  "name": "Boron — terminal screenshot generator",
  "short_name": "Boron",
  "description": "Paste real terminal output, keep its ANSI colors, and export it as a PNG, SVG, JPEG or WebP.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08090d",
  "theme_color": "#08090d",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/mark.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
